{
  // Requires the GODOT4 environment variable to point at the .NET editor executable, e.g.
  // C:\dev\Tools\Godot\Godot_v4.7.2-stable_mono_win64.exe (see README.md > "Editor path").
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/SpaceAutomationSandbox.csproj"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "godot: open editor",
      "type": "process",
      "command": "${env:GODOT4}",
      "args": ["--path", "${workspaceFolder}", "--editor"],
      "problemMatcher": []
    },
    {
      "label": "godot: run main scene",
      "type": "process",
      "command": "${env:GODOT4}",
      "args": ["--path", "${workspaceFolder}"],
      "dependsOn": "build",
      "problemMatcher": []
    }
  ]
}
